#!/usr/bin/env bash
# This repo's fast checks: the script tests and the agent config wiring.
# Run: bash .agents/check    (agents run it through run-project-check.sh)
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

checks=(
  claude/.claude/hooks/test-hooks.sh
  agents/.agents/checks/test-checks.sh
  agents/.agents/skills/pr-draft/scripts/test-branch-state.sh
  agents/.agents/skills/commit/scripts/test-commit-state.sh
  install/check-agent-config.sh
)

for check in "${checks[@]}"; do
  echo "== $check"
  bash "$check"
done

code_health=agents/.agents/tools/code-health
echo "== $code_health pytest"
if command -v uv >/dev/null; then
  uv run --locked --project "$code_health" pytest -q "$code_health"
else
  # uv reaches Windows in step 11 of docs/plans/code-health.md.
  echo "SKIP: uv is not installed"
fi
