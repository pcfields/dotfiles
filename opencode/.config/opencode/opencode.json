{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/claude-sonnet-5",
  "small_model": "github-copilot/claude-haiku-4.5",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 20000
  },
  "instructions": ["./instructions/core.md"],
  "default_agent": "plan",
  "agent": {
    "plan": {
      "description": "Analyze code and create step-by-step plans without making changes.",
      "mode": "primary",
      "model": "github-copilot/claude-sonnet-5",
      "temperature": 0.1,
      "max_steps": 10,
      "prompt": "./instructions/planner.md",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": {
          "*": "deny",
          "explore": "allow",
          "researcher": "allow"
        }
      }
    },
    "architect": {
      "description": "Opt-in high-reasoning planner for architectural decisions, threat modeling, and complex tradeoff analysis. Read-only, Opus 4.7 via Perplexity. Use sparingly.",
      "mode": "primary",
      "model": "perplexity-agent/anthropic/claude-opus-4-7",
      "temperature": 0.2,
      "max_steps": 12,
      "prompt": "./instructions/architect.md",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": {
          "*": "deny",
          "explore": "allow",
          "researcher": "allow"
        }
      }
    },
    "build": {
      "description": "Execute plans with precise, minimal changes to code.",
      "mode": "primary",
      "model": "github-copilot/claude-sonnet-5",
      "max_steps": 20,
      "prompt": "./instructions/implementer.md",
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "ask",
          "git status": "allow",
          "git diff *": "allow",
          "git log *": "allow",
          "git show *": "allow",
          "git add *": "allow",
          "git commit *": "allow",
          "git stash *": "allow",
          "git branch *": "allow",
          "git checkout *": "allow",
          "git switch *": "allow",
          "git tag *": "allow",
          "git rev-parse *": "allow",
          "git remote *": "allow",
          "git fetch *": "allow",
          "git pull *": "allow",
          "cat *": "allow",
          "ls *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",
          "tree *": "allow",
          "find *": "allow",
          "stat *": "allow",
          "file *": "allow",
          "rg *": "allow",
          "fd *": "allow",
          "nix *": "allow",
          "home-manager *": "allow",
          "mise *": "allow",
          "make *": "allow",
          "./install.sh *": "allow",
          "npm *": "allow",
          "npx *": "allow",
          "node *": "allow",
          "pnpm *": "allow",
          "yarn *": "allow",
          "bun *": "allow",
          "jest *": "allow",
          "vitest *": "allow",
          "cargo *": "allow",
          "go *": "allow",
          "python *": "allow",
          "python3 *": "allow",
          "pytest *": "allow",
          "stow *": "allow"
        },
        "task": {
          "*": "deny",
          "coder": "allow",
          "review": "allow",
          "deep-review": "allow",
          "explore": "allow",
          "researcher": "allow",
          "committer": "allow",
          "debugger": "allow",
          "test-writer": "allow",
          "docs": "allow"
        }
      }
    },
    "coder": {
      "description": "Subagent for simple, isolated edits: config changes, renames, comment updates, single-file fixes.",
      "mode": "subagent",
      "model": "github-copilot/claude-haiku-4.5",
      "temperature": 0.1,
      "max_steps": 8,
      "prompt": "./instructions/coder.md",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "deny",
          "git status": "allow",
          "git diff *": "allow",
          "git log *": "allow",
          "git show *": "allow",
          "rg *": "allow",
          "fd *": "allow",
          "cat *": "allow",
          "ls *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",
          "tree *": "allow"
        },
        "task": {
          "*": "deny"
        }
      }
    },
    "review": {
      "description": "Subagent for code review: checks patterns, potential issues, and improvements. Read-only. Escalates Critical findings to @deep-review.",
      "mode": "subagent",
      "model": "github-copilot/claude-haiku-4.5",
      "temperature": 0.1,
      "max_steps": 8,
      "prompt": "./instructions/reviewer.md",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git status": "allow",
          "git diff *": "allow",
          "git log *": "allow",
          "rg *": "allow"
        },
        "task": {
          "*": "deny"
        }
      }
    },
    "deep-review": {
      "description": "High-reasoning code review for critical code (auth, security, data migrations, financial logic). Read-only, Opus 4.7. Invoked when @review escalates.",
      "mode": "subagent",
      "model": "perplexity-agent/anthropic/claude-opus-4-7",
      "temperature": 0.1,
      "max_steps": 10,
      "prompt": "./instructions/deep-review.md",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git status": "allow",
          "git diff *": "allow",
          "git log *": "allow",
          "git show *": "allow",
          "rg *": "allow"
        },
        "task": {
          "*": "deny"
        }
      }
    },
    "researcher": {
      "description": "Research agent using Perplexity Sonar (reasoning-pro) for real-time web search. Saves findings to .research-notes.md.",
      "mode": "subagent",
      "model": "perplexity/sonar-reasoning-pro",
      "temperature": 0.3,
      "max_steps": 8,
      "prompt": "./instructions/researcher.md",
      "permission": {
        "edit": {
          ".research-notes.md": "allow"
        },
        "bash": "deny"
      }
    },
    "committer": {
      "description": "Subagent that drafts conventional commit messages from the staged diff and commits on confirmation.",
      "mode": "subagent",
      "model": "github-copilot/claude-haiku-4.5",
      "temperature": 0.1,
      "max_steps": 5,
      "prompt": "./instructions/committer.md",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git status": "allow",
          "git diff *": "allow",
          "git diff --cached *": "allow",
          "git diff --stat *": "allow",
          "git log *": "allow",
          "git show *": "allow",
          "git rev-parse *": "allow",
          "git branch --show-current": "allow",
          "git add *": "allow",
          "git commit *": "allow"
        },
        "task": {
          "*": "deny"
        }
      }
    },
    "debugger": {
      "description": "Subagent for bug reproduction and localized fixes. Uses the bug-debugging skill.",
      "mode": "subagent",
      "model": "github-copilot/claude-sonnet-5",
      "temperature": 0.1,
      "max_steps": 12,
      "prompt": "./instructions/debugger.md",
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "deny",
          "git status": "allow",
          "git diff *": "allow",
          "git log *": "allow",
          "git show *": "allow",
          "rg *": "allow",
          "fd *": "allow",
          "cat *": "allow",
          "ls *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",
          "tree *": "allow",
          "npm test *": "allow",
          "npm run *": "allow",
          "npx *": "allow",
          "node *": "allow",
          "pnpm *": "allow",
          "yarn *": "allow",
          "bun *": "allow",
          "jest *": "allow",
          "vitest *": "allow",
          "cargo test *": "allow",
          "cargo check *": "allow",
          "go test *": "allow",
          "python *": "allow",
          "python3 *": "allow",
          "pytest *": "allow",
          "mise *": "allow"
        },
        "task": {
          "*": "deny"
        }
      }
    },
    "test-writer": {
      "description": "Subagent that generates focused tests for existing code using the test-generation skill.",
      "mode": "subagent",
      "model": "github-copilot/claude-haiku-4.5",
      "temperature": 0.1,
      "max_steps": 10,
      "prompt": "./instructions/test-writer.md",
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "deny",
          "git status": "allow",
          "git diff *": "allow",
          "rg *": "allow",
          "fd *": "allow",
          "cat *": "allow",
          "ls *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "tree *": "allow",
          "npm test *": "allow",
          "npm run *": "allow",
          "npx *": "allow",
          "node *": "allow",
          "pnpm *": "allow",
          "yarn *": "allow",
          "bun *": "allow",
          "jest *": "allow",
          "vitest *": "allow",
          "cargo test *": "allow",
          "go test *": "allow",
          "python *": "allow",
          "python3 *": "allow",
          "pytest *": "allow",
          "mise *": "allow"
        },
        "task": {
          "*": "deny"
        }
      }
    },
    "docs": {
      "description": "Subagent for documentation updates: READMEs, comments, changelogs. Uses the docs-update skill.",
      "mode": "subagent",
      "model": "github-copilot/claude-haiku-4.5",
      "temperature": 0.1,
      "max_steps": 8,
      "prompt": "./instructions/docs.md",
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "deny",
          "git status": "allow",
          "git diff *": "allow",
          "git log *": "allow",
          "rg *": "allow",
          "fd *": "allow",
          "cat *": "allow",
          "ls *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "tree *": "allow"
        },
        "task": {
          "*": "deny"
        }
      }
    }
  }
}
