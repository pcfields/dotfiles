{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/claude-sonnet-5",
  "small_model": "opencode/gpt-5.6-luna",
  "compaction": { "auto": true, "prune": true, "reserved": 20000 },
  "default_agent": "plan",
  "permission": {
    "edit": "ask",
    "webfetch": "allow",
    "external_directory": "ask",
    "doom_loop": "ask",
    "bash": {
      "*": "ask",

      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git blame*": "allow",
      "git grep*": "allow",
      "git ls-files*": "allow",
      "git rev-parse*": "allow",
      "git merge-base*": "allow",
      "git remote -v": "allow",
      "git branch": "allow",
      "git branch --show-current": "allow",
      "git branch -a*": "allow",
      "git branch -v*": "allow",
      "git branch --list*": "allow",
      "git stash list*": "allow",
      "git worktree list*": "allow",
      "git config --get*": "allow",
      "git range-diff*": "allow",
      "git cherry*": "allow",
      "git shortlog*": "allow",
      "git describe*": "allow",
      "git tag": "allow",
      "git tag -l*": "allow",
      "git tag --list*": "allow",
      "git ls-tree*": "allow",
      "git for-each-ref*": "allow",
      "git reflog": "allow",
      "git reflog show*": "allow",

      "cd*": "allow",
      "pwd": "allow",
      "ls*": "allow",
      "cat*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "grep*": "allow",
      "rg*": "allow",
      "fd*": "allow",
      "find*": "allow",
      "tree*": "allow",
      "wc*": "allow",
      "stat*": "allow",
      "file*": "allow",
      "diff*": "allow",
      "sort*": "allow",
      "uniq*": "allow",
      "cut*": "allow",
      "jq*": "allow",
      "echo*": "allow",
      "which*": "allow",
      "du*": "allow",

      "find * -delete*": "ask",
      "find * -exec*": "ask",
      "git push*": "ask",
      "git commit*": "ask",

      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push * --force*": "deny",
      "git push * -f*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git checkout -- *": "deny",
      "git checkout .": "deny",
      "git restore .": "deny",
      "git branch -D*": "deny",
      "git stash drop*": "deny",
      "git stash clear*": "deny",
      "git filter-branch*": "deny",
      "git filter-repo*": "deny",
      "sudo*": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "rm -rf $HOME*": "deny",
      "npm publish*": "deny",
      "pnpm publish*": "deny",
      "cargo publish*": "deny",
      "gh repo delete*": "deny",
      "gh release create*": "deny",
      "gh pr merge*": "deny"
    }
  }
}
